// ==========================================
// 📩 3. รับข้อความจาก LINE Webhook (doPost)
// ==========================================
function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) {
      return ContentService.createTextOutput("OK");
    }

    const data = JSON.parse(e.postData.contents);
    if (!data.events || data.events.length === 0) return ContentService.createTextOutput("OK");

    const event = data.events[0];

    if (event.type === 'message' && event.message.type === 'text') {
      const userMessage = event.message.text.trim();
      const replyToken = event.replyToken;
      const groupId = event.source.groupId || ''; 
      const sheet = SpreadsheetApp.openById(SHEET_ID).getSheets()[0];

      // 1. ฟังก์ชันขอคู่มือ
      if (userMessage === 'ขอคู่มือ' || userMessage === '#คู่มือ' || userMessage === 'คู่มือ') {
        const manualText = 
          "📖 คู่มือการสั่งงานบอทข่าวประจำทีม\n\n" +
          "1. ส่งข่าวเข้ากองกลาง (แอดมิน):\n" +
          "👉 พิมพ์: #บรีฟ [ลิงก์ข่าว] [บรีฟเพิ่มเติม]\n" +
          "ตัวอย่าง: #บรีฟ https://tiktok.com/... ดราม่าข่าวด่วน\n\n" +
          "2. รับงานไปเขียนสคริปต์ (ครีเอทีฟ):\n" +
          "👉 พิมพ์: #รับงาน [รหัสงาน] [ชื่อตัวเอง]\n" +
          "ตัวอย่าง: #รับงาน N001 เจได\n\n" +
          "3. ส่งคลิปที่ตัดเสร็จ (ตัดต่อ):\n" +
          "👉 พิมพ์: #ส่งงาน [รหัสงาน] [ลิงก์ไดรฟ์/คลิป]\n" +
          "ตัวอย่าง: #ส่งงาน N001 https://drive.google.com/...\n\n" +
          "4. ตรวจงานผ่าน (แอดมิน):\n" +
          "👉 พิมพ์: #ผ่าน [รหัสงาน]\n\n" +
          "⏰ ระบบจะดึงงานที่มีคนรับผิดชอบแล้ว เข้าคลังคลิปในเว็บทุกคืนครับ";
        
        replyMsg(replyToken, manualText);
        return ContentService.createTextOutput("OK");
      }

      // 2. ฟังก์ชัน #บรีฟ (โยนงาน)
      if (userMessage.startsWith('#บรีฟ')) {
        const content = userMessage.replace('#บรีฟ', '').trim();
        const jobId = 'N' + (sheet.getLastRow()).toString().padStart(3, '0');
        const timestamp = new Date();

        // 👈 ดึงชื่อช่องอัตโนมัติจาก Group ID ที่ส่งมา
        const channelConfig = GROUP_TO_CHANNEL[groupId] || GROUP_TO_CHANNEL['DEFAULT'];
        const channelName = channelConfig.name;

        // บันทึกลง Sheet: Col A ถึง Col I
        // [รหัสงาน, วันที่, ข้อมูลบรีฟ, สถานะ, ผู้รับผิดชอบ, ลิงก์งานเสร็จ, GroupId, ช่อง, สถานะซิงค์]
        sheet.appendRow([jobId, timestamp, content, 'รอรับงาน', '', '', groupId, channelName, '']);
        replyMsg(replyToken, `📝 บันทึกงาน ${jobId} (สำหรับ: ${channelName}) แล้ว!\nใครพร้อมรับบรีฟ พิมพ์: #รับงาน ${jobId} [ชื่อตัวเอง] ได้เลยครับ`);
      }
      // 3. ฟังก์ชัน #รับงาน
      else if (userMessage.startsWith('#รับงาน')) {
        const parts = userMessage.split(' ');
        const jobId = parts[1];
        const name = parts.slice(2).join(' ') || 'ทีมงาน';
        if (jobId) {
          updateSheet(jobId, 'กำลังทำสคริปต์', name, '');
          replyMsg(replyToken, `👍 รับทราบ! ${name} รับผิดชอบงาน ${jobId} แล้วครับ`);
        }
      }
      // 4. ฟังก์ชัน #ส่งงาน
      else if (userMessage.startsWith('#ส่งงาน')) {
        const parts = userMessage.split(' ');
        const jobId = parts[1];
        const link = parts.slice(2).join(' ');
        if (jobId) {
          updateSheet(jobId, 'รอตรวจ', '', link);
          replyMsg(replyToken, `🎬 งาน ${jobId} ส่งงานแล้ว!\nแอดมินตรวจคลิปได้ที่: ${link}`);
        }
      }
      // 5. ฟังก์ชัน #ผ่าน
      else if (userMessage.startsWith('#ผ่าน')) {
        const parts = userMessage.split(' ');
        const jobId = parts[1];
        if (jobId) {
          updateSheet(jobId, 'เสร็จสิ้น', '', '');
          replyMsg(replyToken, `🎉 เยี่ยมมาก! งาน ${jobId} ตรวจผ่านแล้ว`);
        }
      }
    }
  } catch (err) {
    console.error("Error:", err.toString());
  }

  return ContentService.createTextOutput("OK");
}

// อัปเดตข้อมูลในชีต
function updateSheet(jobId, status, worker, link) {
  const sheet = SpreadsheetApp.openById(SHEET_ID).getSheets()[0];
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] === jobId) {
      const row = i + 1;
      if (status) sheet.getRange(row, 4).setValue(status);
      if (worker) sheet.getRange(row, 5).setValue(worker);
      if (link) sheet.getRange(row, 6).setValue(link);
      break;
    }
  }
}

// ==========================================
// 🌙 4. ฟังก์ชันซิงค์เข้าคลังคลิป Supabase (รันทุกคืน)
// ==========================================
function syncContentsToSupabase() {
  const sheet = SpreadsheetApp.openById(SHEET_ID).getSheets()[0];
  const data = sheet.getDataRange().getValues();
  
  const rowsToInsert = [];
  const rowsIndexToUpdate = [];

  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const jobId = row[0];        // Col A: รหัสงาน
    const createdAt = row[1];    // Col B: วันที่
    const briefContent = row[2]; // Col C: บรีฟและลิงก์
    const sheetStatus = (row[3] || '').toString().trim();  // Col D: สถานะ
    const worker = (row[4] || '').toString().trim();       // Col E: ผู้รับผิดชอบ
    const doneLink = (row[5] || '').toString().trim();     // Col F: ลิงก์งานเสร็จ
    const groupId = (row[6] || '').toString().trim();      // Col G: GroupId
    const channelName = (row[7] || '').toString().trim();  // Col H: ช่อง
    const syncStatus = row[8];   // Col I: สถานะซิงค์เว็บ (index 8)

    // ข้ามแถวที่ไม่มีรหัสงาน หรือซิงค์ไปแล้ว
    if (!jobId || syncStatus === 'SYNCED') continue;

    // 🔒 เงื่อนไขสำคัญ: ต้องมีผู้รับผิดชอบแล้ว หรือสถานะไม่ใช่ "รอรับงาน"
    const hasWorker = worker !== '' && worker !== '-';
    const isAccepted = sheetStatus !== '' && sheetStatus !== 'รอรับงาน';

    if (!hasWorker && !isAccepted) {
      // ข้ามไปก่อน รอมีคนมารับงานในวันหลัง
      continue;
    }

    // 🔄 แปลงสถานะในชีตเป็นสถานะในตาราง contents
    let contentStatus = 'SCRIPT';
    if (sheetStatus === 'รอตรวจ') contentStatus = 'REVIEW';
    else if (sheetStatus === 'เสร็จสิ้น') contentStatus = 'DONE';

    // 📺 หา Channel ID จาก GroupId หรือ ChannelName
    const groupConf = GROUP_TO_CHANNEL[groupId] || GROUP_TO_CHANNEL['DEFAULT'];
    const channelId = groupConf ? groupConf.channelId : null;

    // 👥 หา User ID ของผู้รับผิดชอบ
    const matchedUserId = USER_MAPPING[worker] || null;
    const assigneeIds = matchedUserId ? [matchedUserId] : [];

    // หัวข้อคอนเทนต์
    const cleanBrief = (briefContent || '').toString().trim();
    const shortTitle = cleanBrief.length > 60 
      ? cleanBrief.substring(0, 60) + '...' 
      : cleanBrief || `งานข่าว ${jobId}`;

    // รายละเอียดคอนเทนต์
    let fullDesc = `📌 รหัสงาน: ${jobId}\n`;
    if (channelName) fullDesc += `📺 ช่อง: ${channelName}\n`;
    if (cleanBrief) fullDesc += `📝 บรีฟ: ${cleanBrief}\n`;
    if (worker) fullDesc += `👤 ผู้รับผิดชอบ: ${worker}\n`;
    if (doneLink) fullDesc += `🔗 ลิงก์ส่งงาน: ${doneLink}\n`;
    fullDesc += `\n(นำเข้าจาก LINE Bot เมื่อ ${new Date().toLocaleString('th-TH')})`;

    rowsToInsert.push({
      title: `[${jobId}] ${shortTitle}`,
      description: fullDesc,
      status: contentStatus,
      channel_id: channelId,              // 👈 ผูกกับ Channel ID ของช่อง A/B/C
      assignee_ids: assigneeIds,          // 👈 ใส่ ID ผู้รับผิดชอบ
      is_unscheduled: true,               // 👈 เข้าหน้า ContentStock อัตโนมัติ
      tags: ['LINE_BOT', jobId, channelName, worker].filter(Boolean),
      type: 'CONTENT',
      created_at: createdAt ? new Date(createdAt).toISOString() : new Date().toISOString(),
      updated_at: new Date().toISOString()
    });

    rowsIndexToUpdate.push(i + 1);
  }

  if (rowsToInsert.length === 0) {
    console.log("ℹ️ ไม่มีงานที่มีผู้รับผิดชอบพร้อมซิงค์ในคืนนี้");
    return;
  }

  // ส่งข้อมูลเข้าตาราง contents ใน Supabase
  const endpoint = `${SUPABASE_URL}/rest/v1/contents`;
  const options = {
    method: 'post',
    headers: {
      'apikey': SUPABASE_ANON_KEY,
      'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
      'Content-Type': 'application/json',
      'Prefer': 'return=minimal'
    },
    payload: JSON.stringify(rowsToInsert),
    muteHttpExceptions: true
  };

  try {
    const response = UrlFetchApp.fetch(endpoint, options);
    const statusCode = response.getResponseCode();

    if (statusCode === 200 || statusCode === 201) {
      // มาร์กว่า SYNCED ใน Col I (คอลัมน์ที่ 9)
      rowsIndexToUpdate.forEach(rowNum => {
        sheet.getRange(rowNum, 9).setValue('SYNCED');
      });
      console.log(`✅ ซิงค์เข้าคลังคลิปสำเร็จ: ${rowsToInsert.length} งาน`);
    } else {
      console.error("❌ Supabase Error:", response.getContentText());
    }
  } catch (error) {
    console.error("❌ Network Error:", error.toString());
  }
}

// 📨 ฟังก์ชันส่งข้อความ LINE
function replyMsg(replyToken, text) {
  UrlFetchApp.fetch('https://api.line.me/v2/bot/message/reply', {
    'headers': {
      'Content-Type': 'application/json; charset=UTF-8',
      'Authorization': 'Bearer ' + LINE_TOKEN,
    },
    'method': 'post',
    'payload': JSON.stringify({
      'replyToken': replyToken,
      'messages': [{'type': 'text', 'text': text}]
    })
  });
}