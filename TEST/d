// --- STRICTMODE & MULTI-INSTANCE SAFE CHANNEL WRAPPER ---
// Prevents "cannot add `postgres_changes` callbacks for realtime:... after `subscribe()`"
// when React.StrictMode double-mounts effects on localhost or when Sidebar + MobileNavigation mount simultaneously.
const originalChannel = supabase.channel.bind(supabase);
let channelInstanceSeq = 0;

supabase.channel = ((name: string, opts?: any) => {
    const existingChannels = supabase.getChannels?.() || [];
    const expectedTopic = `realtime:${name}`;
    const collision = existingChannels.find((ch: any) => ch.topic === expectedTopic);

    // If a channel with this exact topic already exists and has already called subscribe()
    // (or is still awaiting async removeChannel cleanup in React.StrictMode),
    // assign a unique topic suffix so .on('postgres_changes', ...) never attaches to a subscribed channel.
    const safeName =
        collision && ((collision as any).subscribedOnce || collision.state !== 'closed')
            ? `${name}__inst_${++channelInstanceSeq}`
            : name;

    const ch = originalChannel(safeName, opts);

    // Extra safety guard on ch.on() in case the same channel reference is ever chained after subscribe()
    const originalOn = ch.on.bind(ch);
    (ch as any).on = (type: string, filter: any, callback: any) => {
        if ((ch as any).subscribedOnce && type === 'postgres_changes') {
            console.warn(
                `[Supabase Realtime] Skipped adding duplicate postgres_changes listener to already-subscribed channel: ${safeName}`
            );
            return ch;
        }
        return originalOn(type as any, filter, callback);
    };

    return ch;
}) as typeof supabase.channel;
